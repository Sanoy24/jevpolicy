{
  "name": "@jevpolicy/core",
  "version": "0.1.0",
  "description": "Policy-as-code for probabilistic software decisions.",
  "keywords": [
    "ai",
    "decision-engine",
    "jev",
    "policy",
    "policy-as-code",
    "vercel-ai-sdk"
  ],
  "homepage": "https://github.com/Sanoy24/jevpolicy#readme",
  "bugs": {
    "url": "https://github.com/Sanoy24/jevpolicy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoy24/jevpolicy.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "jevpolicy": "dist/cli/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.87",
    "@ai-sdk/provider": "4.0.17",
    "ai": "7.0.107",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
